APP_VERSION=0.2.0
SEARCH_LIMIT=50

# Demo deployment: no external MySQL required.
ENABLE_SQLITE_FALLBACK=1
SQLITE_FALLBACK_PATH=/tmp/monalex_dictionary.sqlite3

# Required to enable the AI assistant.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_INPUT_LIMIT=1200

# Optional production MySQL configuration. Set ENABLE_SQLITE_FALLBACK=0 when
# you want MySQL to be required instead of using the generated SQLite cache.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=dictionary
MYSQL_TABLE=dictionary
